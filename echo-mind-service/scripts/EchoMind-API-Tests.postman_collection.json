{
  "info": {
    "name": "EchoMind 智能客服 API 测试",
    "description": "EchoMind Sidecar 服务的 API 测试集合\n\n基础路径: http://localhost:8082\n\n包含:\n1. 对话接口 (POST /api/chat)\n2. 流式对话 (POST /api/chat/stream)\n3. 评测接口 (POST /api/eval/run)\n4. 监控接口 (GET /api/monitor/metrics)\n5. 健康检查 (GET /actuator/health)\n\n测试前请确保 echo-mind-service 已启动，AI_API_KEY 已配置。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1️⃣ 对话接口",
      "description": "非流式对话接口，支持商户查询、优惠券、用户服务等全场景",
      "item": [
        {
          "name": "1.1 商户推荐 - 川菜馆推荐",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码200', () => { pm.response.to.have.status(200); });",
                  "pm.test('返回成功', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(200);",
                  "    pm.expect(json.data).to.not.be.null;",
                  "    pm.expect(json.data.answer).to.not.be.null;",
                  "    pm.expect(json.data.intent).to.not.be.null;",
                  "    pm.expect(json.data.intentConfidence).to.be.at.least(0);",
                  "    pm.expect(json.data.agentUsed).to.not.be.null;",
                  "    pm.expect(json.data.sessionId).to.not.be.null;",
                  "});",
                  "",
                  "pm.test('意图为商户推荐', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.intent).to.eql('shop_recommend');",
                  "});",
                  "",
                  "pm.test('响应延迟存在', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.metrics.latencyMs).to.be.at.least(0);",
                  "});",
                  "",
                  "console.log('回答内容:', pm.response.json().data.answer);",
                  "console.log('耗时:', pm.response.json().data.metrics.latencyMs, 'ms');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": 10001,\n    \"message\": \"帮我推荐一家评分高的川菜馆\",\n    \"sessionId\": \"session-test-001\",\n    \"stream\": false\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/chat",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "chat"]
            }
          }
        },
