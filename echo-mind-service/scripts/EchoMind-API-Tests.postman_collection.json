    {
      "name": "2️⃣ 评测接口",
      "description": "LLM-as-Judge 四维度评测（准确性、相关性、完整性、友好度）",
      "item": [
        {
          "name": "2.1 执行评测 - 全维度",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码200', () => { pm.response.to.have.status(200); });",
                  "pm.test('返回评测结果', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(200);",
                  "    pm.expect(json.data).to.not.be.null;",
                  "    pm.expect(json.data.overallScore).to.be.at.least(1);",
                  "    pm.expect(json.data.dimensionScores).to.not.be.null;",
                  "    pm.expect(json.data.sampleCount).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('包含四维度评分', () => {",
                  "    const { accuracy, relevance, completeness, friendliness } = pm.response.json().data.dimensionScores;",
                  "    pm.expect(accuracy).to.be.at.least(1).and.to.be.at.most(5);",
                  "    pm.expect(relevance).to.be.at.least(1).and.to.be.at.most(5);",
                  "    pm.expect(completeness).to.be.at.least(1).and.to.be.at.most(5);",
                  "    pm.expect(friendliness).to.be.at.least(1).and.to.be.at.most(5);",
                  "});",
                  "",
                  "pm.test('生成了批次ID', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.batchId).to.match(/eval-/);",
                  "});",
                  "",
                  "console.log('评测批次:', pm.response.json().data.batchId);",
                  "console.log('综合评分:', pm.response.json().data.overallScore);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"dataset\": \"golden_answers_v1\",\n    \"sampleSize\": 3,\n    \"dimensions\": [\"accuracy\", \"relevance\", \"completeness\", \"friendliness\"]\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/eval/run",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "eval", "run"]
            }
          }
        },
        {
          "name": "2.2 获取评测报告",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8082/api/eval/report/eval-20240315-001",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "eval", "report", "eval-20240315-001"]
            }
          }
        }
      ]
