    {
      "name": "2️⃣ 流式对话接口 (SSE)",
      "description": "基于 Spring WebFlux + Flux 的 Server-Sent Events 流式输出\n\n调用方式:\n1. Postman 发送 POST 请求到 /api/chat/stream\n2. 设置 Accept: text/event-stream\n3. 响应会逐字推送，包含 thinking/token/done 三种事件类型\n\ncurl 示例:\ncurl -X POST http://localhost:8082/api/chat/stream \\\n  -H 'Content-Type: application/json' \\\n  -H 'Accept: text/event-stream' \\\n  -d '{\"userId\":1,\"message\":\"推荐一家好吃的火锅店\",\"sessionId\":\"stream-001\"}'",
      "item": [
        {
          "name": "2.1 SSE 流式对话 - 商户推荐",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码200', () => { pm.response.to.have.status(200); });",
                  "pm.test('返回SSE流式格式', () => {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.include('data:');",
                  "    pm.expect(body).to.include('event:');",
                  "});",
                  "",
                  "pm.test('包含thinking事件', () => {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.include('\"type\":\"thinking\"');",
                  "});",
                  "",
                  "pm.test('包含token事件', () => {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.include('\"type\":\"token\"');",
                  "});",
                  "",
                  "pm.test('包含done事件', () => {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.include('\"type\":\"done\"');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": 10001,\n    \"message\": \"帮我推荐一家评分高的川菜馆\",\n    \"sessionId\": \"stream-test-001\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/chat/stream",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "chat", "stream"]
            }
          }
        },
