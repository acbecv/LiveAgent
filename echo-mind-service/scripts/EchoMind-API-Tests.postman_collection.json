    {
      "name": "4️⃣ 监控接口",
      "description": "Agent 性能指标和路由权重查询",
      "item": [
        {
          "name": "4.1 获取监控指标",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码200', () => { pm.response.to.have.status(200); });",
                  "pm.test('返回指标数据', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(200);",
                  "    pm.expect(json.data).to.not.be.null;",
                  "});",
                  "",
                  "pm.test('包含系统级指标', () => {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.system).to.not.be.null;",
                  "    pm.expect(data.system).to.have.property('totalRequests');",
                  "    pm.expect(data.system).to.have.property('overallSatisfaction');",
                  "});",
                  "",
                  "pm.test('包含权重信息', () => {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property('weights');",
                  "});",
                  "",
                  "console.log('系统请求总数:', pm.response.json().data.system.totalRequests);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
