# ============================================
# LLSP 环境变量配置示例
# 复制此文件为 .env 并修改对应值
# 注意：请勿将 .env 文件提交到版本控制系统
# ============================================

# ============================================
# 数据库配置 (MySQL)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=llsp
DB_USERNAME=root
DB_PASSWORD=your_password

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# RabbitMQ 配置
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

# ============================================
# AI 服务配置 (通义千问 / OpenAI 兼容)
# ============================================
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_MODEL=qwen3.5-flash
AI_EMBEDDING_MODEL=text-embedding-v3

# ============================================
# ChromaDB 配置 (AI 向量数据库)
# ============================================
CHROMADB_URL=http://localhost:8000

# ============================================
# Canal 配置 (数据同步)
# ============================================
CANAL_SERVER=127.0.0.1:11111
CANAL_DESTINATION=example

# ============================================
# 邮件配置 (用于验证码发送)
# ============================================
MAIL_USER=your_email@qq.com
MAIL_PASSWORD=your_email_smtp_token

# ============================================
# 服务端口配置
# ============================================
SERVER_PORT=8081
AI_SERVER_PORT=8082

# ============================================
# 主服务地址 (AI 服务调用)
# ============================================
DIANPING_BASE_URL=http://localhost:8081
